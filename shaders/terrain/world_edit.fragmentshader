            f32 IQSample = w.w+iq_sdBox(w.xyz, RectRad);
            if (Hollow > 0.f) { IQSample = iq_opOnion(IQSample, Hollow ); }
            InitialSample = -IQSample;

          } break;

          // ShapeType_Sphere
          case 1:
          {
            v3 EditRelativeSphereCenter = Op.EditRelativeSphereCenter;

            f32 r = (Radius - Hollow);
            v3 p  = EditRelxyz - (EditRelativeSphereCenter);
            if (Normalized) { p /= EditDim; }
            p += BasisOffset;

            v4 w = DoInputTransforms(p, RotMatrix, Stretch, Repeat);
            f32 IQSample  = w.w+iq_sdSphere(w.xyz, r);
            if (Hollow > 0.f) { IQSample = iq_opOnion(IQSample, Hollow ); }

            InitialSample = -IQSample;
          } break;

          // ShapeType_Line
          case 2:
          {
            v3 p = EditRelxyz;
            v3 start = v3(Radius);
            v3 end = EditDim-v3(Radius);

            v4 w = DoInputTransforms(p, RotMatrix, Stretch, Repeat);
            f32 IQSample  = w.w+iq_sdRoundedLine(w.xyz, start, end, Radius);
            /* if (Hollow > 0.f) { IQSample = iq_opOnion(IQSample, Hollow ); } */
            InitialSample = -IQSample;
          } break;

          // ShapeType_Cylinder
          case 3:
          {
            f32 h = Op.Height;
            f32 r = Radius;

            v3 p = (EditRelxyz - EditRad);
            if (Normalized) { p /= EditDim; }

            // NOTE(Jesse): I dunno why we have to subtract BasisOffset here when
            // we add it everywhere else .. but .. that's how the maff works out
            // I guess.  If we add it, we get the opposite translation as other shapes.
            // @subtract_basis_offset_instead_of_add
            p -= BasisOffset;

            v4 w = DoInputTransforms(p, RotMatrix, Stretch, Repeat);

            f32 IQSample = w.w+iq_sdCappedCylinder(w.xyz, h, r);
            if (Hollow > 0.f) { IQSample = iq_opOnion(IQSample, Hollow ); }
            InitialSample = -IQSample;
          } break;

          // ShapeType_Plane
          case 4:
          {
            f32 Dist = DistanceToPlane(PlaneNormal, Planed, EditRelxyz);
            if (abs(Dist) < PlaneRadius*ChunkResolution.x)
            {
              InitialSample = 1.f;
            }
          } break;

          // ShapeType_Torus
          case 5:
          {
            v2  t = v2(Radius, MinorRadius);
            v3  p = EditRelxyz;

            v3  BoxR = EditDim/2.f;
            // @subtract_basis_offset_instead_of_add
            p = EditRelxyz - BasisOffset;
            p   -= BoxR;

            v4 w = DoInputTransforms(p, RotMatrix, Stretch, Repeat);

            f32 IQSample = w.w+iq_sdTorus( w.xyz, t );
            if (Hollow > 0.f) { IQSample = iq_opOnion(IQSample, Hollow ); }

            InitialSample = -IQSample;

          } break;

          // ShapeType_Pyramid
          case 6:
          {
            f32 S = EditDim.z;

            f32  h = Radius > 0.f ? Radius : 1.f;

            v3  BoxR = EditDim/(2.f*S);
            v3  p = (EditRelxyz-BasisOffset)/EditDim;
            p.xy   -= 0.5f;

            v4 w = DoInputTransforms(p, RotMatrix, Stretch, Repeat);

            f32 IQSample = w.w+iq_sdPyramid( w.xyz, h );
            if (Hollow > 0.f) { IQSample = iq_opOnion(IQSample, Hollow ); }

            InitialSample = -IQSample;
          } break;

          // @sdf_shape_step(7): Add more cases and implementations here
          // for shape types added in Step 1
          //
        }

        InitialSample += Rounding;
      } break;

      default: {ColorAccumulator = V3(1.f, 0.f, 1.f);  InitialSample = 1.f;} break;
    }


    if (Power != 0.f)
    {
      InitialSample *= Power;
    }


    f32 ThisSample = (InitialSample + ValueBias);
    if (Invert)
    {
      ThisSample = ThisSample * -1.f;
    }









    if ( (ValueModifiers & (1<<1)) > 0) // WorldEdit_ValueModifier_ClampPos
    {
      ThisSample = max(0.f, ThisSample);
    }

    if ( (ValueModifiers & (1<<2)) > 0) // WorldEdit_ValueModifier_ClampNeg
    {
      ThisSample = min(0.f, ThisSample);
    }

    if ( (ValueModifiers & (1<<3)) > 0) // WorldEdit_ValueModifier_Threshold
    {
      if (abs(InitialSample) < Threshold) { ThisSample = 0.f; }
    }

    if ( (ValueModifiers & (1<<4)) > 0) // WorldEdit_ValueModifier_Discard
    {
      ThisSample = 0.f;
    }


    BlendSample(BlendMode, 0, Accumulator, ColorAccumulator, ThisSample, ColorSample);

    // We sample the blend texture outside the bounds check because we need to pass
    // the previous stage sample values through
    if (SampleBlendTex > 0)
    {
      v4 TexLookup = texelFetch(BlendTex, ivec2(gl_FragCoord.xy), 0);

      f32 BlendValue = TexLookup.a;
      v3 BlendColor = TexLookup.rgb;

      // Conceptually, we want to blend the accumulator into the blendvalue here,
      // so we don't do it this way.
      /* BlendSample(BlendTexBlendMode, Accumulator, ColorAccumulator, BlendValue, BlendColor ); */
      /* BlendSample(BlendTexBlendMode, 0 /1* WorldEdit_ColorBlendMode_ValuePositive *1/ , BlendValue, BlendColor, Accumulator, ColorAccumulator); */
      /* BlendSample(BlendTexBlendMode, ColorMode, BlendValue, BlendColor, Accumulator, ColorAccumulator); */
      BlendSample(BlendTexBlendMode, 5, BlendValue, BlendColor, Accumulator, ColorAccumulator);
      Accumulator = BlendValue;
      ColorAccumulator = BlendColor;
    }
  }
  else
  {
    // if we were outside the affected brush region, we just pass the blend values through
    if (SampleBlendTex > 0)
    {
      v4 TexLookup = texelFetch(BlendTex, ivec2(gl_FragCoord.xy), 0);
      Accumulator = TexLookup.a;
      ColorAccumulator = TexLookup.rgb;;
    }

  }




  Output.a = Accumulator;
  Output.rgb = ColorAccumulator;
}
