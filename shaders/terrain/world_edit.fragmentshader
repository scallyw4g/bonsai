}

v3 lattice_hash(v3 p, f32 jit)
{
  /* return p; */
  return p + (jit*((hash3f(p))));
}

f32 rect_lattice( vec3 x, f32 rad, f32 squareness)
{
  vec3 p  = floor( x );

  vec3 hp = lattice_hash(p, squareness);

  f32 off = 1.0f;
  f32 ret = 0.f;
  {
    vec3 oP = p + v3(off,0,0);
    ret = max(ret, iq_sdRoundedLine(x, hp, lattice_hash(oP, squareness), rad )*-1.f);
  }
  {
    vec3 oP = p + v3(0,off,0);
    ret = max(ret, iq_sdRoundedLine(x, hp, lattice_hash(oP, squareness), rad )*-1.f);
  }
  {
    vec3 oP = p + v3(0,0,off);
    ret = max(ret, iq_sdRoundedLine(x, hp, lattice_hash(oP, squareness), rad )*-1.f);
  }

  {
    vec3 oP = p + v3(-off,0,0);
    ret = max(ret, iq_sdRoundedLine(x, hp, lattice_hash(oP, squareness), rad )*-1.f);
  }
  {
    vec3 oP = p + v3(0,-off,0);
    ret = max(ret, iq_sdRoundedLine(x, hp, lattice_hash(oP, squareness), rad )*-1.f);
  }
  {
    vec3 oP = p + v3(0,0,-off);
    ret = max(ret, iq_sdRoundedLine(x, hp, lattice_hash(oP, squareness), rad )*-1.f);
  }

  return ret;
}
















