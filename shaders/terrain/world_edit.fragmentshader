float iq_opSmoothUnion( float d1, float d2, float k )
{
    d1 *= -1.f;
    d2 *= -1.f;

    k *= 4.0;
    float h = max(k-abs(d1-d2),0.0);
    return -1.f* (min(d1, d2) - h*h*0.25/k);
}

float iq_opSmoothSubtraction( float d1, float d2, float k )
{
    return -iq_opSmoothUnion(d1,-d2,k);

    //k *= 4.0;
    // float h = max(k-abs(-d1-d2),0.0);
    // return max(-d1, d2) + h*h*0.25/k;
}

float iq_opSmoothIntersection( float d1, float d2, float k )
{
    return -iq_opSmoothUnion(-d1,-d2,k);

    //k *= 4.0;
