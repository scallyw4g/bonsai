void Shaping_main(in v3 GlobalPosition, in v3 LocalPosition, inout v3 ColorValue, inout f32 NoiseValue)
{
  f32 x = LocalPosition.x;
  f32 z = LocalPosition.z;
  f32 y = LocalPosition.y;
  v3 Basis = GlobalPosition;
  // NOTE(Jesse): Set these in the -- user code -- section
  ColorValue = V3(0.f);
  NoiseValue = 0.f;
  //
  // -- user code -- 
  //
  {

    v3 Period = V3(1800.f);
    float Amplitude = 1000.f;
    f32 StartingZDepth = DEFAULT_FLOOR_HEIGHT;
    s32 Octaves = 3;
    NoiseValue = StartingZDepth;

    f32 warp = 0.f;

    for (s32 Octave = 1; Octave <= Octaves; ++Octave)
    {
      v3 xyz = Basis / (Period/Octave);

      f32 gn = gradient_noise_derivs(xyz+warp).x;
      NoiseValue += gn*(Amplitude/Octave);
    }

    NoiseValue -= Basis.z;
    ColorValue = V3(0.2f, 0.8f, 0.15f);
  }

  //
  // -- end user code --
  //
}
