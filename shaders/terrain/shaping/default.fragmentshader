uniform  v2 SampleRemapCurvePoints[16];
uniform u32 SampleRemapCurvePointCount;

// NOTE: Must be >= TERRAIN_BATCH_CHUNK_COUNT (see graphics.h)
#define TERRAIN_BATCH_MAX_CHUNK_COUNT 32

// The textures hold a batch of chunks.  Chunk k, voxel (x,y,z), in a texture
// with per-axis dimension D is stored at texel (x + D*y, z + D*k), so each
// chunk is a contiguous block of rows, and the texture is (D*D, D*BatchCount).
uniform v3 BatchChunkBasis[TERRAIN_BATCH_MAX_CHUNK_COUNT];
uniform v3 BatchChunkResolution[TERRAIN_BATCH_MAX_CHUNK_COUNT];

uniform s32 Stage;

uniform sampler2D ShapingTex;
uniform sampler2D DerivsTex;
uniform sampler2D InputTex; // Finalize stage input

in vec2 UV;
layout(location = 0) out v4 Output;
layout(location = 1) out uint FinalizeOutput;

// Unpacks a texel coordinate into (x,y,z) and returns the chunk index
s32 UnpackBatchCoord(ivec2 Texel, s32 D, out ivec3 xyz)
{
  s32 ChunkIndex = Texel.y / D;
  xyz.z = Texel.y - (ChunkIndex*D);
  xyz.y = Texel.x / D;
  xyz.x = Texel.x - (xyz.y*D);
  return ChunkIndex;
}

ivec2 PackBatchCoord(ivec3 xyz, s32 ChunkIndex, s32 D)
{
  return ivec2(xyz.x + (xyz.y*D), xyz.z + (ChunkIndex*D));
}

// Same as ComputeNormal, but for a texture holding a batch of chunks.
// Neighbors outside the chunk are treated as zero.
//
v3 ComputeNormalBatched(sampler2D Tex, ivec3 xyz, s32 ChunkIndex, s32 InputD, s32 OutputD, f32 ChunkResolutionZ)
{
  s32 InputOffset = (InputD - OutputD)/2;
  ivec3 InputXYZ = xyz + ivec3(InputOffset);

  f32 CurrentNoiseValue = texelFetch(Tex, PackBatchCoord(InputXYZ, ChunkIndex, InputD), 0).a;

  v3 Normal = v3(0.f);

  for ( s32 dz = -1; dz < 2; ++ dz)
  for ( s32 dy = -1; dy < 2; ++ dy)
  for ( s32 dx = -1; dx < 2; ++ dx)
  {
    if (dz == 0 && dy == 0 && dx == 0) continue;

    ivec3 N = InputXYZ + ivec3(dx,dy,dz);

    f32 Next = 0.f;
    if (all(greaterThanEqual(N, ivec3(0))) && all(lessThan(N, ivec3(InputD))))
    {
      Next = texelFetch(Tex, PackBatchCoord(N, ChunkIndex, InputD), 0).a;
    }

    f32 Diff = Next-(dz*ChunkResolutionZ) - Truncate(CurrentNoiseValue);
    Normal += V3(dx,dy,dz)*Diff;
  }

  return -1.f * Normalize(Normal);
}

void main()
{
  v3 ColorValue = V3(0);
  f32 NoiseValue = 0;

  ivec2 Texel = ivec2(gl_FragCoord.xy);
  ivec3 xyz;

  switch (Stage)
  {
    // Shaping : Write the shaped noise value and color for a (68^3) region per chunk
    case 0:
    {
      s32 ChunkIndex = UnpackBatchCoord(Texel, 68, xyz);

      v3 Basis = BatchChunkBasis[ChunkIndex] + (v3(xyz)*BatchChunkResolution[ChunkIndex]);

      Shaping_main(Basis, V3(xyz), ColorValue, NoiseValue);
    } break;

    // Derivs : Compute normals (66^3 per chunk) from the shaping output
    case 1:
    {
      s32 ChunkIndex = UnpackBatchCoord(Texel, 66, xyz);

      ColorValue = ComputeNormalBatched(ShapingTex, xyz, ChunkIndex, 68, 66, BatchChunkResolution[ChunkIndex].z);
    } break;

    // Decoration : Modify the shaping output (66^3 per chunk) using the derivs
    case 2:
    {
      s32 ChunkIndex = UnpackBatchCoord(Texel, 66, xyz);

      v3 Basis = BatchChunkBasis[ChunkIndex] + (v3(xyz)*BatchChunkResolution[ChunkIndex]);

      v4 TexLookup = texelFetch(ShapingTex, PackBatchCoord(xyz + ivec3(1), ChunkIndex, 68), 0);
      v3 NormalValue = texelFetch(DerivsTex, Texel, 0).xyz;

      ColorValue = TexLookup.rgb;
      NoiseValue = TexLookup.a;

      Decoration_main(Basis, V3(xyz), NormalValue, ColorValue, NoiseValue);
    } break;

    // Finalize : Pack solid bit, normal and color (66^3 per chunk) into a u32 per voxel.
    // Writes to FinalizeOutput (attachment 1), not Output.
    case 3:
    {
      v4 TexLookup = texelFetch(InputTex, Texel, 0);

      uint SolidBit = TexLookup.a > 0.f ? 1u : 0u;

      s32 ChunkIndex = UnpackBatchCoord(Texel, 66, xyz);
      v3 Normal = ComputeNormalBatched(InputTex, xyz, ChunkIndex, 66, 66, 1.f);

      uint PackedNormal = PackV3_15b(Normal);
      uint PackedColor = PackV3_655b(TexLookup.rgb.grb);

      FinalizeOutput = (SolidBit << 31) | (PackedNormal << 16) | PackedColor;
      return;
    } break;
  }

  Output.rgb = ColorValue;
  Output.a = NoiseValue;
}
