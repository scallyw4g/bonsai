uniform  v2 SampleRemapCurvePoints[16];
uniform u32 SampleRemapCurvePointCount;

uniform v3 WorldspaceChunkBasis;
uniform v3 ChunkResolution;

uniform s32 Stage;

uniform sampler2D ShapingTex;
uniform sampler2D DerivsTex;

in vec2 UV;
out v4 Output;

void main()
{
  v3 ColorValue = V3(0);
  f32 NoiseValue = 0;

  switch (Stage)
  {
    // Shaping : Write the shaped noise value and color for a (68^3) region
    case 0:
    {
      f32 x = floor(gl_FragCoord.x);
      f32 z = floor(gl_FragCoord.y / 68);
      f32 y = floor(gl_FragCoord.y - (z*68));

      v3 Basis = WorldspaceChunkBasis + (v3(x,y,z)*ChunkResolution);

      Shaping_main(Basis, V3(x,y,z), ColorValue, NoiseValue);
    } break;

    // Derivs : Compute normals (66^3) from the shaping output
    case 1:
    {
      ivec2 ShapingTexDim = ivec2(68);
      ivec2 OutputTexDim = ivec2(66);

      ColorValue = ComputeNormal(ShapingTex, gl_FragCoord.xy, ShapingTexDim, OutputTexDim, ChunkResolution.z);
    } break;

    // Decoration : Modify the shaping output (66^3) using the derivs
    case 2:
    {
      f32 x = floor(gl_FragCoord.x);
      f32 z = floor(gl_FragCoord.y / 66);
      f32 y = floor(gl_FragCoord.y - (z*66));

      v3 Basis = WorldspaceChunkBasis + (v3(x,y,z)*ChunkResolution);

      ivec2 InputTexCoord = ivec2(gl_FragCoord.x + 1, (y + 1) + (z * 68) + 68 );
      v4 TexLookup = texelFetch(ShapingTex,  InputTexCoord, 0);
      v3 NormalValue = texelFetch(DerivsTex, ivec2(gl_FragCoord.xy), 0).xyz;

      ColorValue = TexLookup.rgb;
      NoiseValue = TexLookup.a;

      Decoration_main(Basis, V3(x,y,z), NormalValue, ColorValue, NoiseValue);
    } break;
  }

  Output.rgb = ColorValue;
  Output.a = NoiseValue;
}
