uniform sampler2D InputTex;
uniform v3 ChunkResolution;

in vec2 UV;
out uint Output;

// Chunk k, voxel (x,y,z) in a texture with per-axis dimension D is stored at
// texel (x + D*y, z + D*k), so each chunk is a contiguous block of rows.
s32 UnpackBatchCoord(ivec2 Texel, s32 D, out ivec3 xyz)
{
  s32 ChunkIndex = Texel.y / D;
  xyz.z = Texel.y - (ChunkIndex*D);
  xyz.y = Texel.x / D;
  xyz.x = Texel.x - (xyz.y*D);
  return ChunkIndex;
}

ivec2 PackBatchCoord(ivec3 xyz, s32 ChunkIndex, s32 D)
{
  return ivec2(xyz.x + (xyz.y*D), xyz.z + (ChunkIndex*D));
}

// Same as ComputeNormal, but for a texture holding a batch of chunks.
// Neighbors outside the chunk are treated as zero.
//
v3 ComputeNormalBatched(sampler2D Tex, ivec3 xyz, s32 ChunkIndex, s32 InputD, s32 OutputD, f32 ChunkResolutionZ)
{
  s32 InputOffset = (InputD - OutputD)/2;
  ivec3 InputXYZ = xyz + ivec3(InputOffset);

  f32 CurrentNoiseValue = texelFetch(Tex, PackBatchCoord(InputXYZ, ChunkIndex, InputD), 0).a;

  v3 Normal = v3(0.f);

  for ( s32 dz = -1; dz < 2; ++ dz)
  for ( s32 dy = -1; dy < 2; ++ dy)
  for ( s32 dx = -1; dx < 2; ++ dx)
  {
    if (dz == 0 && dy == 0 && dx == 0) continue;

    ivec3 N = InputXYZ + ivec3(dx,dy,dz);

    f32 Next = 0.f;
    if (all(greaterThanEqual(N, ivec3(0))) && all(lessThan(N, ivec3(InputD))))
    {
      Next = texelFetch(Tex, PackBatchCoord(N, ChunkIndex, InputD), 0).a;
    }

    f32 Diff = Next-(dz*ChunkResolutionZ) - Truncate(CurrentNoiseValue);
    Normal += V3(dx,dy,dz)*Diff;
  }

  return -1.f * Normalize(Normal);
}

void main()
{
  ivec2 Texel = ivec2(gl_FragCoord.xy);
  v4 TexLookup = texelFetch(InputTex, Texel, 0);

  f32 NoiseValue = TexLookup.a;
  v3  ColorValue = TexLookup.rgb;

  uint SolidBit = NoiseValue > 0.f ? 1u : 0u;

  ivec3 xyz;
  s32 ChunkIndex = UnpackBatchCoord(Texel, 66, xyz);
  v3 Normal = ComputeNormalBatched(InputTex, xyz, ChunkIndex, 66, 66, 1.f);
  /* v3 Normal = Normalize(V3(1,1,0)); */

  uint PackedNormal = PackV3_15b(Normal);
  uint PackedColor = PackV3_655b(ColorValue.grb);

  /* if (LengthSq(ColorValue) == 0.f) { SolidBit = 0u; } */
  /* if (LengthSq(ColorValue) == 0.f) { SolidBit = 0u; } */

  Output = (SolidBit << 31) | (PackedNormal << 16) | PackedColor;
}
