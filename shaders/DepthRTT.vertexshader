layout(location = VERTEX_POSITION_LAYOUT_LOCATION) in vec3 vertexPosition_modelspace;

uniform mat4 ViewProjection;

out vec3 vertexP_worldspace;

struct transform_data
{
  mat4 ModelMatrix;
  mat4 NormalMatrix;
};

layout(std430, binding = 0) readonly buffer TransformBuffer
{
  transform_data Transforms[];
};

void main()
{
  transform_data Transform = Transforms[gl_DrawID];
  vec4 WorldVertex = Transform.ModelMatrix * vec4(vertexPosition_modelspace, 1);

  vertexP_worldspace = WorldVertex.xyz;
  gl_Position = ViewProjection * WorldVertex;
}

