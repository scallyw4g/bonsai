float
Linearize(float Depth)
{
  float Result = (2.0 * NearClip) / (FarClip + NearClip - Depth * (FarClip - NearClip));
  return Result;
}

bool IsNear(float A, float B)
{
  float Thresh = 0.02f;
  if ( A < B+Thresh && A > B-Thresh )
  {
    return true;
  }
  return false;
}

float
GridLineIntegral(float Position, float Width, float Period)
{
  float HalfPeriod = 0.5f * Period;
  float Extent = min(Width, HalfPeriod);
  float Area = 2.f * Extent - Extent * Extent / Width;
  float Cell = floor((Position + HalfPeriod) / Period);
  float Local = Position - Cell * Period;
  float Distance = min(abs(Local), Extent);
  return Cell * Area + 0.5f * Area +
         sign(Local) * (Distance - Distance * Distance / (2.f * Width));
}

float
FilteredGridLine(float Position, float PixelWidth, float Width, float Period)
{
  float Phase = mod(Position, Period);
  if (PixelWidth <= Width * 0.01f)
  {
    float Distance = min(Phase, Period - Phase);
    return clamp(1.f - Distance / Width, 0.f, 1.f);
  }

  // Integrate the periodic line profile over the pixel footprint.
  float HalfPixel = 0.5f * PixelWidth;
  float Coverage = (GridLineIntegral(Phase + HalfPixel, Width, Period) -
                    GridLineIntegral(Phase - HalfPixel, Width, Period)) / PixelWidth;
  return clamp(Coverage, 0.f, 1.f);
}

float
ModThresh(vec3 In, vec3 Normal, vec3 PixelWidth, float Thresh, float ModVal)
{
  float NormalLength = length(Normal);
  if (NormalLength == 0.f) { return 0.f; }

  vec3 AxisWeight = vec3(1.f) - clamp(abs(Normal / NormalLength), 0.f, 1.f);
  vec3 Contrib;
  for (int Axis = 0; Axis < 3; ++Axis)
  {
    Contrib[Axis] = FilteredGridLine(In[Axis], PixelWidth[Axis], Thresh, ModVal) * AxisWeight[Axis];
  }
  return max(max(Contrib.x, Contrib.y), Contrib.z);
}

