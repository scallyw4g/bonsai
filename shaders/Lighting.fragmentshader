const float PI = 3.14159265359f;

// GGX / Trowbridge-Reitz normal distribution
float DistributionGGX(float NdotH, float Roughness)
{
  float a  = Roughness*Roughness;
  float a2 = a*a;
  float d  = (NdotH*NdotH) * (a2 - 1.f) + 1.f;
  return a2 / max(PI*d*d, 0.0001f);
}

// Schlick-GGX geometry term (direct lighting k)
float GeometrySchlickGGX(float NdotX, float Roughness)
{
  float r = Roughness + 1.f;
  float k = (r*r) / 8.f;
  return NdotX / (NdotX*(1.f-k) + k);
}

vec3 FresnelSchlick(float CosTheta, vec3 F0)
{
  return F0 + (1.f - F0) * pow(clamp(1.f - CosTheta, 0.f, 1.f), 5.f);
}

// Cook-Torrance BRDF; returns outgoing radiance (albedo included) for one light.
vec3 PbrLightingCalc(vec3 Albedo, float Roughness, float Metallic, vec3 Radiance, vec3 FragToLight, vec3 FragToCamera, vec3 FragNormal)
{
  vec3 N = FragNormal;
  vec3 L = FragToLight;
  vec3 V = FragToCamera;
  vec3 H = normalize(L + V);

  float NdotL = max(dot(N, L), 0.f);
  float NdotV = max(dot(N, V), 0.0001f);
  float NdotH = max(dot(N, H), 0.f);
  float HdotV = max(dot(H, V), 0.f);

  vec3 F0 = mix(vec3(0.04f), Albedo, Metallic);

  float D = DistributionGGX(NdotH, Roughness);
  float G = GeometrySchlickGGX(NdotV, Roughness) * GeometrySchlickGGX(NdotL, Roughness);
  vec3  F = FresnelSchlick(HdotV, F0);

  vec3 Specular = (D*G*F) / max(4.f*NdotV*NdotL, 0.0001f);

  vec3 kD = (vec3(1.f) - F) * (1.f - Metallic);

  return (kD*Albedo/PI + Specular) * Radiance * NdotL;
}


