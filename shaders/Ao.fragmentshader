in vec2 UV;
out float Output;

uniform sampler2D gPosition;
uniform sampler2D gNormal;
uniform sampler2D gDepth;
uniform sampler2D SsaoNoiseTexture;

const int SSAO_KERNEL_SIZE = 32;
uniform vec3 SsaoKernel[SSAO_KERNEL_SIZE];
uniform float SsaoRadius;

uniform mat4 InverseViewMatrix;
uniform mat4 ViewProjection;

void main()
{
  ivec2 BufferDim = textureSize(gDepth, 0);
  ivec2 FragTexel = clamp(ivec2(UV * vec2(BufferDim)), ivec2(0), BufferDim - 1);
  if (texelFetch(gDepth, FragTexel, 0).r >= 1.f)
  {
    Output = 1.f;
    return;
  }

  vec3 FragPosition = texelFetch(gPosition, FragTexel, 0).xyz;
  vec3 FragNormal = normalize(texelFetch(gNormal, FragTexel, 0).xyz);
  ivec2 NoiseTexel = ivec2(gl_FragCoord.xy) % textureSize(SsaoNoiseTexture, 0);
  vec3 Noise = texelFetch(SsaoNoiseTexture, NoiseTexel, 0).xyz;
  vec3 Right = cross(Noise, FragNormal);
  if (dot(Right, Right) < 0.0001f)
  {
    vec3 Axis = abs(FragNormal.z) < 0.9f ? vec3(0.f, 0.f, 1.f) : vec3(0.f, 1.f, 0.f);
    Right = cross(Axis, FragNormal);
  }
  Right = normalize(Right);
  vec3 Front = cross(FragNormal, Right);
  mat3 Reorientation = mat3(Right, Front, FragNormal);

  vec3 ViewDirection = -InverseViewMatrix[2].xyz;
  float Bias = SsaoRadius * 0.025f;
  float Occlusion = 0.f;
  for (int KernelIndex = 0; KernelIndex < SSAO_KERNEL_SIZE; ++KernelIndex)
  {
    vec3 SampleP = FragPosition + Reorientation * SsaoKernel[KernelIndex] * SsaoRadius;
    vec4 Projected = ViewProjection * vec4(SampleP, 1.f);
    if (Projected.w <= 0.f) { continue; }

    vec2 SampleUV = (Projected.xy / Projected.w) * 0.5f + 0.5f;
    if (any(lessThan(SampleUV, vec2(0.f))) || any(greaterThanEqual(SampleUV, vec2(1.f))))
      continue;

    ivec2 SampleTexel = ivec2(SampleUV * vec2(BufferDim));
    if (texelFetch(gDepth, SampleTexel, 0).r >= 1.f) { continue; }

    vec3 SurfaceP = texelFetch(gPosition, SampleTexel, 0).xyz;
    vec3 SurfaceDelta = SurfaceP - FragPosition;
    float DepthDelta = dot(SurfaceDelta, ViewDirection);
    float RangeWeight = smoothstep(0.f, 1.f, SsaoRadius / max(abs(DepthDelta), SsaoRadius * 0.0001f));
    if (dot(SurfaceP - SampleP, ViewDirection) < -Bias && dot(SurfaceDelta, FragNormal) > Bias)
      Occlusion += RangeWeight;
  }

  Output = 1.f - Occlusion / float(SSAO_KERNEL_SIZE);
}
